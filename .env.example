# --- Database (Neon PostgreSQL, pgvector enabled) ---
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/datematch?sslmode=require"

# --- Clerk (staff + client portal auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# Comma-separated emails that become admin staff on first sign-in
# (bootstrap only — manage staff in /settings afterwards).
ADMIN_BOOTSTRAP_EMAILS="you@agency.com"

# --- Anthropic (match rationales + intake summaries) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Voyage AI (bio embeddings, 1024-dim; Anthropic's embeddings partner) ---
VOYAGE_API_KEY="pa-..."

# --- Vercel Blob (client photo uploads; auto-set when the store is linked) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Resend (staff notifications, optional client intro emails) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="agency@example.com"

# --- Inngest (background jobs: score recompute, embeddings, reminders) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- PostHog (internal usage analytics) ---
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
